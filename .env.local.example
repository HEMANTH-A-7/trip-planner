# Copy this file to .env.local and fill in your own key.
# .env.local is gitignored — never commit real keys.
# Get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: fallback provider used automatically if Gemini is rate-limited
# or misconfigured, so one provider outage doesn't take the whole app down.
# Get a free key at https://openrouter.ai/keys — leave blank to disable.
OPENROUTER_API_KEY=

# Optional: Pexels image search, used to find a real photograph of the
# destination for a trip's hero. Free tier at https://www.pexels.com/api/
# Leave blank and the bundled themed image is used instead — nothing breaks.
PEXELS_API_KEY=
